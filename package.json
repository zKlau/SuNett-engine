{
  "name": "sunett",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @zklau/sunett-engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "knip": "npm run knip --workspace @zklau/sunett-engine",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zKlau/SuNett-engine.git"
  },
  "homepage": "https://github.com/zKlau/SuNett-engine#readme",
  "bugs": {
    "url": "https://github.com/zKlau/SuNett-engine/issues"
  },
  "author": "Claudiu Padure",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.62.0",
    "prettier": "3.8.3"
  }
}
